# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443
DJANGO_SECURE_SSL=False

# Razorpay test keys. Leave blank when payment is not being tested.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password-reset email. Local development uses the console backend by default.
DEFAULT_FROM_EMAIL=no-reply@negiluai.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# PostgreSQL. Set every value in production; when all are absent Django uses local SQLite.
POSTGRES_DB=agritrade
POSTGRES_USER=agritrade
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Internal ML service (Step 10)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SECONDS=5
